<odoo>
<record id="action_track_my_fleet_vehicles" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">tree,kanban,form</field>
</record>
<record id="view_fleet_maintenance_form" model="ir.ui.view">
    <field name="name">fleet.maintenance.form</field>
    <field name="model">fleet.maintenance</field>
    <field name="arch" type="xml">
      <form string="Fleet Maintenance">
                <header>
                    <field name="stage" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Maintenance Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Brake Pads Replacement"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Vehicle Details">
                            <field name="vehicle_id"/>
                            <field name="mileage"/>
                            <field name="defect_type"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Scheduling &amp; Costs">
                            <field name="tehnician"/>
                            <field name="target_date"/>
                            <field name="estimated_down_time"/>
                            <field name="service_cost"/>
                        </group>
                    </group>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
                </sheet>
            </form>
    </field>
</record>
<record id="view_fleet_maintenance_tree" model="ir.ui.view">
    <field name="name">fleet.maintenance.tree</field>
    <field name="model">fleet.maintenance</field>
    <field name="arch" type="xml">
        <tree string="Fleet Maintenance Records">
            <field name="name"/>
            <field name="vehicle_id"/>
            <field name="defect_type"/>
            <field name="priority" widget="priority"/>
            <field name="stage"/>
        </tree>
    </field>
</record>
<record id="view_fleet_maintenance_kanban" model="ir.ui.view">
        <field name="name">fleet.maintenance.kanban</field>
        <field name="model">fleet.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" records_draggable="false" class="o_kanban_small_column">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="defect_type"/>
                <field name="mileage"/>
                <field name="priority"/>
                <field name="stage"/>
                <field name="tehnician"/>
                <field name="target_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mt-2">
                                <div><strong>Vehicle:</strong> <field name="vehicle_id"/></div>
                                <div><strong>Defect:</strong> <field name="defect_type"/></div>
                                <div t-if="record.tehnician.raw_value"><strong>Technician:</strong> <field name="tehnician"/></div>
                                <div t-if="record.target_date.raw_value"><strong>Target Date:</strong> <field name="target_date"/></div>
                                <div t-if="record.service_cost.raw_value"><strong>Cost:</strong> <field name="service_cost"/></div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
</record>
<record id="action_fleet_maintenance" model="ir.actions.act_window">
<field name="name">Fleet Maintenance</field>
<field name="res_model">fleet.maintenance</field>
<field name="view_mode">tree,kanban,form</field>
</record>
<record id="action_server_needs_parts_procurement" model="ir.actions.server">
    <field name="name">Mark 'Needs Parts' &amp; Create Procurement Task</field>
    <field name="model_id" ref="model_fleet_maintenance"/>
    <field name="binding_model_id" ref="model_fleet_maintenance"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">
        records.action_trigger_procurement_task()
        </field>
</record>
</odoo>