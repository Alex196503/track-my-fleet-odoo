<templates xml:space="preserve">
    <t t-name="track_my_fleet.MaintenanceSummary" owl="1">
        <div class="container-fluid my-3 p-3 bg-view border rounded shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="m-0 fw-bold text-primary">
                    <i class="fa fa-wrench me-2"/>Fleet Maintenance Summary
                </h5>
                <button class="btn btn-sm btn-outline-secondary" t-on-click="fetchSummaryData">
                    <i class="fa fa-refresh me-1"/>Refresh
                </button>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 bg-warning-subtle border border-warning rounded text-center">
                        <span class="d-block text-uppercase fw-bold text-warning-emphasis small">Needs Parts</span>
                        <span class="fs-2 fw-bolder" t-out="state.counts.needs_parts"/>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-info-subtle border border-info rounded text-center">
                        <span class="d-block text-uppercase fw-bold text-info-emphasis small">In Progress</span>
                        <span class="fs-2 fw-bolder" t-out="state.counts.in_progress"/>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-success-subtle border border-success rounded text-center">
                        <span class="d-block text-uppercase fw-bold text-success-emphasis small">Completed</span>
                        <span class="fs-2 fw-bolder" t-out="state.counts.completed"/>
                    </div>
                </div>
            </div>
            <div class="container-fluid border rounded p-3 bg-white shadow-sm">
                <h6 class="fw-bold text-danger mb-3">
                    <i class="fa fa-exclamation-triangle me-2"/>High Priority Maintenance Required
                </h6>

                <t t-if="state.highPriorityList.length > 0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Vehicle</th>
                                    <th>Defect Type</th>
                                    <th>Stage</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.highPriorityList" t-as="item" t-key="item.id">
                                    <tr>
                                        <td class="fw-bold">
                                            <t t-out="item.vehicle_id ? item.vehicle_id[1] : 'N/A'"/>
                                        </td>
                                        <td><t t-out="item.defect_type or '-'"/></td>
                                        <td>
                                            <span class="badge bg-danger">
                                                <t t-out="item.stage"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
                <t t-else="">
                    <p class="text-muted mb-0 small">No high priority issues pending.</p>
                </t>
            </div>
        </div>
    </t>
</templates>