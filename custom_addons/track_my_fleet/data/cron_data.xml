<odoo>
        <record id="ir_cron_weekly_overdue_maintenance" model="ir.cron">
            <field name="name">Fleet Maintenance: Send Weekly Overdue Email</field>
            <field name="model_id" ref="model_fleet_maintenance"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_overdue_maintenance_email()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
</odoo>